{
  "name": "paybox-tribunal",
  "version": "1.0.0",
  "description": "Pay-on-validation for x402: agents only pay when the result meets the contract.",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "testnet:setup": "node scripts/testnet-e2e.ts setup",
    "testnet:run": "node scripts/testnet-e2e.ts run"
  },
  "keywords": [],
  "author": "exoticdev (https://github.com/Exoticdevelopment)",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@hono/node-server": "^2.1.5",
    "@solana/kit": "5.5.1",
    "@x402/core": "^2.28.0",
    "@x402/evm": "^2.28.0",
    "@x402/hono": "^2.28.0",
    "@x402/svm": "^2.28.0",
    "hono": "^4.13.13",
    "viem": "^2.57.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.18"
  },
  "overrides": {
    "typescript": "$typescript"
  }
}
