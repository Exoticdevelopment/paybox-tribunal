# Wallet that RECEIVES payments: public 0x address only. Never a seed phrase or private key.
PAY_TO=0x0000000000000000000000000000000000000000
# Base Sepolia for testing; eip155:8453 for Base mainnet (needs a mainnet facilitator)
NETWORK=eip155:84532
FACILITATOR_URL=https://x402.org/facilitator
# Default price per call; override per service with PRICE_INVOICE / PRICE_SUMMARY
PRICE=$0.01
PORT=4021

# Signs credit vouchers and receipts. Generate with: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
VOUCHER_SECRET=change-me

# AI for extraction, summaries and the judge:
#   off = deterministic fallbacks, judge abstains (free)
#   cli = your local Claude Code login (`claude -p`). Local testing only, refused when deployed.
#   api = Anthropic API, needs ANTHROPIC_API_KEY. Use this when deployed.
#   gemini = Google Gemini, needs GEMINI_API_KEY (free tier at aistudio.google.com).
# Defaults to api when ANTHROPIC_API_KEY is set, otherwise off.
LLM_BACKEND=off
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Model for the api backend. claude-haiku-5-5 is ~40x cheaper and keeps cost below the price.
LLM_MODEL=claude-opus-5-5

# 1 = accept the x-demo-fault header to force bad results on camera. Never enable in production.
DEMO_FAULTS=0

# off = services are free, for local testing (e.g. trying the judge). Refused when deployed.
PAYWALL=on

# Seller token required to publish promises when deployed (x-admin-token header).
ADMIN_TOKEN=
